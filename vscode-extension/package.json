{
  "name": "tapl-workflow-viewer",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "2.1.0",
  "publisher": "paragonnov",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/qkdxorjs1002/tapl.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/qkdxorjs1002/tapl#readme",
  "bugs": {
    "url": "https://github.com/qkdxorjs1002/tapl/issues"
  },
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "keywords": [
    "tapl",
    "workflow",
    "mcp",
    "planning",
    "tasks"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:taplWorkflow.active",
    "onView:taplWorkflow.archives",
    "onCommand:taplWorkflow.refresh",
    "onCommand:taplWorkflow.openOverview",
    "onCommand:taplWorkflow.openArchive",
    "onCommand:taplWorkflow.search"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "tsc -p ./ && node scripts/bundle-extension.mjs",
    "compile:webview": "vite build && node scripts/sync-viewer-assets.mjs",
    "watch": "tsc -watch -p ./",
    "watch:webview": "vite build --watch",
    "package": "vsce package --no-dependencies --out tapl-workflow-viewer-$npm_package_version.vsix",
    "package:pre-release": "vsce package --pre-release --no-dependencies --out tapl-workflow-viewer-$npm_package_version-pre-release.vsix"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vscode/vsce": "^3.0.0",
    "autoprefixer": "10.4.20",
    "daisyui": "4.12.24",
    "esbuild": "0.21.5",
    "github-markdown-css": "^5.9.0",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "^6.0.0",
    "vite": "5.4.20"
  },
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "taplWorkflow.taplMcpPath": {
          "type": "string",
          "default": "",
          "description": "Path or command name for the tapl-mcp stdio server. Leave empty to search PATH plus common Homebrew locations."
        },
        "taplWorkflow.layout": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "small",
            "medium",
            "large"
          ],
          "enumItemLabels": [
            "%configuration.layout.enum.auto.label%",
            "%configuration.layout.enum.small.label%",
            "%configuration.layout.enum.medium.label%",
            "%configuration.layout.enum.large.label%"
          ],
          "enumDescriptions": [
            "%configuration.layout.enum.auto.description%",
            "%configuration.layout.enum.small.description%",
            "%configuration.layout.enum.medium.description%",
            "%configuration.layout.enum.large.description%"
          ],
          "title": "%configuration.layout.title%",
          "description": "%configuration.layout.description%"
        },
        "taplWorkflow.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "enumItemLabels": [
            "%configuration.language.enum.auto.label%",
            "%configuration.language.enum.ko.label%",
            "%configuration.language.enum.en.label%"
          ],
          "enumDescriptions": [
            "%configuration.language.enum.auto.description%",
            "%configuration.language.enum.ko.description%",
            "%configuration.language.enum.en.description%"
          ],
          "title": "%configuration.language.title%",
          "description": "%configuration.language.description%"
        }
      }
    },
    "commands": [
      {
        "command": "taplWorkflow.refresh",
        "title": "%command.refresh.title%",
        "category": "%command.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "taplWorkflow.openOverview",
        "title": "%command.openOverview.title%",
        "category": "%command.category%",
        "icon": "$(preview)"
      },
      {
        "command": "taplWorkflow.openArchive",
        "title": "%command.openArchive.title%",
        "category": "%command.category%",
        "icon": "$(archive)"
      },
      {
        "command": "taplWorkflow.search",
        "title": "%command.search.title%",
        "category": "%command.category%",
        "icon": "$(search)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "taplWorkflow",
          "title": "tapl",
          "icon": "resources/workflow.svg"
        }
      ]
    },
    "views": {
      "taplWorkflow": [
        {
          "id": "taplWorkflow.active",
          "name": "%view.active.name%"
        },
        {
          "id": "taplWorkflow.archives",
          "name": "%view.archives.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "taplWorkflow.refresh",
          "when": "view == taplWorkflow.active || view == taplWorkflow.archives",
          "group": "navigation"
        },
        {
          "command": "taplWorkflow.search",
          "when": "view == taplWorkflow.active",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "taplWorkflow.openOverview",
          "when": "viewItem == tapl-overview",
          "group": "inline"
        },
        {
          "command": "taplWorkflow.openArchive",
          "when": "viewItem == tapl-archive",
          "group": "inline"
        }
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.4.3"
  }
}
